# Firebase configuration (Web App)
# Récupérer ces valeurs dans :
# Firebase Console -> Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration
# https://console.firebase.google.com/

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# SMTP - utilisé par le formulaire de contact ET l'envoi automatique
# du mail au client à la création d'un album.
#
# Exemple Gmail (mot de passe d'application requis):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=contact@jg-photographie.fr
#   SMTP_PASS=xxxx xxxx xxxx xxxx
#   MAIL_FROM="Julie Grohens Photographe <contact@jg-photographie.fr>"
#   MAIL_TO=contact@jg-photographie.fr
#   MAIL_REPLY_TO=contact@jg-photographie.fr
#
# Exemple OVH / IONOS / autre (SMTP perso du domaine jg-photographie.fr):
#   SMTP_HOST=ssl0.ovh.net   (ou smtp.ionos.fr, etc.)
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=contact@jg-photographie.fr
#   SMTP_PASS=<mot de passe de la boîte mail>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@jg-photographie.fr
SMTP_PASS=
MAIL_FROM="Julie Grohens Photographe <contact@jg-photographie.fr>"
MAIL_TO=contact@jg-photographie.fr
MAIL_REPLY_TO=contact@jg-photographie.fr
